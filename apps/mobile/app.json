{
  "expo": {
    "name": "Witness",
    "slug": "witness",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.witnesslives.witness",
      "supportsTablet": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "NSLocationWhenInUseUsageDescription": "Witness uses your location to show which of your ancestors lived near where you are standing.",
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.witnesslives.witness.gedcom",
            "UTTypeDescription": "GEDCOM Family Tree",
            "UTTypeConformsTo": [
              "public.data",
              "public.text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "ged"
              ],
              "public.mime-type": [
                "application/x-gedcom",
                "text/vnd.familysearch.gedcom"
              ]
            }
          },
          {
            "UTTypeIdentifier": "com.witnesslives.witness.gedcom-archive",
            "UTTypeDescription": "FamilySearch GEDCOM Archive",
            "UTTypeConformsTo": [
              "public.zip-archive"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "gdz"
              ],
              "public.mime-type": [
                "application/zip"
              ]
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "GEDCOM Family Tree",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.witnesslives.witness.gedcom",
              "com.witnesslives.witness.gedcom-archive"
            ]
          }
        ]
      },
      "buildNumber": "19",
      "appleTeamId": "SLD65K94V7",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:app.witnesslives.com"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1917",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "./plugins/with-gedcom-guard.js",
      "./plugins/with-pod-deployment-target.js",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Witness uses the camera to photograph headstones, so it can read the inscription and check the person against your tree."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}